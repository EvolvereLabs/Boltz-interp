# Cloudflare R2 credentials for the activation store.
#
# These are credentials WE ISSUE TO YOU, scoped to the activation bucket -- not
# credentials from your own Cloudflare account. Request them from the
# corresponding author of the accompanying paper; see docs/DATA_ACCESS.md.
#
# Copy this file to .env and fill in the values you were issued.
# The .env file is gitignored and will persist across terminal sessions.

# Cloudflare account ID (auto-constructs the endpoint URL)
CF_ACCOUNT_ID=

# Scoped R2 access key pair
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Alternative: the full R2 endpoint URL (use instead of CF_ACCOUNT_ID if preferred)
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Note: the bucket name is NOT read from here -- pass it to get_activations.py
# as --bucket. See docs/DATA_ACCESS.md.
